# Aether runs on the keys you already have. No paid model names required.

# Required in production. Use a long random string.
AETHER_SECRET=change-me-in-production-use-a-long-random-string

# Explicit local development fallback only. Never true in production.
# false + a provider key  -> Aether lists that key's models and picks a free-tier id.
# true                    -> the built-in Aether Engine (rule-based, not a real model).
AI_MOCK_MODE=false

# Provider keys. That is all a free account needs.
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional free-tier overrides only.
# Leave unset and Aether asks the provider which model ids this key can call
# (GET /models), then picks the cheapest/fastest one it actually returned.
# Set these only if you want to pin the exact id from your provider dashboard.
# Never required — never put a paid-only id here.
# OPENAI_MODEL=
# GEMINI_MODEL=
# GROK_MODEL=

# Optional endpoints / tuning.
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# XAI_BASE_URL=https://api.x.ai/v1
# AI_DISCOVERY_TIMEOUT_MS=4000
# AI_TIMEOUT_MS=60000
# AI_MAX_RETRIES=2

# Seed demo@aether.local / demo and admin@aether.local — development only.
ALLOW_DEMO_ACCOUNTS=false

NEXT_PUBLIC_APP_NAME=Aether
NEXT_PUBLIC_APP_URL=http://localhost:3000