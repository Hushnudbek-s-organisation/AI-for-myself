# Required in production. Use a long random string.
AETHER_SECRET=change-me-in-production-use-a-long-random-string

# true = local UI without real AI. Never true in production.
AI_MOCK_MODE=false

# Seed demo@aether.local / demo — development only.
ALLOW_DEMO_ACCOUNTS=false

# Paste keys only. Model names are optional — chat picks ChatGPT / Gemini / Grok.
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional. Only if an account needs a specific model id.
# OPENAI_MODEL=
# GEMINI_MODEL=
# GROK_MODEL=

NEXT_PUBLIC_APP_NAME=Aether
NEXT_PUBLIC_APP_URL=http://localhost:3000
