# Required in production. Use a long random string.
AETHER_SECRET=change-me-in-production-use-a-long-random-string

# Explicit development fallback only. Never true in production.
# When false, at least one provider key is required or chat returns 503.
AI_MOCK_MODE=false

# Seed demo@aether.local / demo and admin@aether.local — development only.
ALLOW_DEMO_ACCOUNTS=false

# OpenAI / ChatGPT (official SDK, Responses API, store=false)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Set these to model IDs your OpenAI account can actually use.
AI_MODEL_DEFAULT=gpt-5.5
AI_MODEL_FAST=gpt-5.5
AI_MODEL_REASONING=gpt-5.5
# Wire id for catalog entry gpt-6-luna (ChatGPT 6 Luna)
OPENAI_MODEL_LUNA=gpt-6-luna

# Gemini (Google AI Studio generateContent)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# Grok (xAI OpenAI-compatible Chat Completions)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.7

AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

NEXT_PUBLIC_APP_NAME=Aether
NEXT_PUBLIC_APP_URL=http://localhost:3000
